      "name": "Search ATS jobs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const seen = new Set();\nconst domains = [];\nfor (const item of items) {\n  const slug = item.json.company_slug;\n  if (!slug) continue;\n  const d = `https://${slug}.com`;\n  if (seen.has(d)) continue;\n  seen.add(d);\n  domains.push(d);\n  if (domains.length >= 10) break;\n}\nreturn [{ json: { domains } }];"
      },
